{
  "name": "govjobs-alerts",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node --test test/*.test.js",
    "seed": "node scripts/seed-sources.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.19.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "node-cron": "^3.0.3",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
